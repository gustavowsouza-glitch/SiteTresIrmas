# Copie para .env (ignorado pelo Git). Não coloque credenciais neste exemplo.
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Use local apenas para testar a caixa de solicitações em localhost, sem e-mails.
# Para enviar e-mails reais, use resend e preencha as configurações abaixo.
ACCESS_MAIL_MODE=resend
# Para envio via Resend: chave privada e remetente autorizado no serviço.
RESEND_API_KEY=
MAIL_FROM=
